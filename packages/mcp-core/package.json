{
  "name": "@discord-mcp/core",
  "version": "0.25.1",
  "private": false,
  "type": "module",
  "description": "Typed caller-owned Discord operations for AI agents, with safety controls, resilience, and verifiable guild builds.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discord",
    "ai",
    "claude",
    "cursor"
  ],
  "license": "Apache-2.0",
  "homepage": "https://cappyeo.github.io/discord-mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cappyeo/discord-mcp.git",
    "directory": "packages/mcp-core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "catalog:build": "node --experimental-sqlite scripts/catalog/build.mjs",
    "dev": "tsdown --watch",
    "test": "vitest run && node --experimental-sqlite --test scripts/catalog/build.test.mjs",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md','README.md');require('node:fs').copyFileSync('../../LICENSE','LICENSE');\"",
    "postpack": "node -e \"try{require('node:fs').unlinkSync('README.md');require('node:fs').unlinkSync('LICENSE');}catch{}\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "cockatiel": "^3.2.1",
    "discord-api-types": "^0.38.54",
    "pino": "^9.5.0"
  },
  "peerDependencies": {
    "@discordjs/rest": "^2.4.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sapphire/pieces": "^4.4.1",
    "discord.js": "^14.16.3",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "discord.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@discord-mcp/server-mocks": "workspace:*",
    "@discordjs/rest": "^2.6.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@mswjs/interceptors": "^0.42.3",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@sapphire/pieces": "^4.4.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "discord.js": "^14.27.0",
    "msw": "^2.15.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7",
    "zod": "4.4.3"
  }
}
