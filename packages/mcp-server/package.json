{
  "name": "@discord-mcp/cli",
  "version": "0.13.1",
  "private": false,
  "type": "module",
  "mcpName": "io.github.jhm1909/discord-mcp",
  "description": "Discord MCP server — stdio transport CLI",
  "bin": {
    "discord-mcp": "./dist/cli.js",
    "discord-mcp-server": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discord",
    "ai",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "homepage": "https://cappyeo.github.io/discord-mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cappyeo/discord-mcp.git",
    "directory": "packages/mcp-server"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md','README.md');require('node:fs').copyFileSync('../../LICENSE','LICENSE');\"",
    "postpack": "node -e \"try{require('node:fs').unlinkSync('README.md');require('node:fs').unlinkSync('LICENSE');}catch{}\""
  },
  "dependencies": {
    "@discord-mcp/core": "workspace:*",
    "@discordjs/rest": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@sapphire/pieces": "^4.4.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "commander": "^12.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@discord-mcp/server-mocks": "workspace:*",
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
