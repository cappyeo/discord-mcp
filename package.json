{
  "name": "discord-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@hono/node-server": "2.0.12",
      "ws": ">=8.21.0",
      "undici": "^6.27.0",
      "express-rate-limit": "^8.6.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "bench": "turbo run bench",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "publint": "^0.3.22",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
