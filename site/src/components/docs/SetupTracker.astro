---
import { getCollection } from 'astro:content';
import TutorialProgress from './TutorialProgress.astro';
import TutorialUnitProgress from './TutorialUnitProgress.astro';

export interface Props {
  id?: string;
}

const { id = 'tutorial' } = Astro.props;
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const hrefFor = (entryId: string) => `${basePath}${entryId}/`;

const tutorialPages = (await getCollection('docs'))
  .filter((entry) => entry.data.type === 'tutorial')
  .sort((left, right) => {
    const leftOrder = left.data.sidebar.order ?? Number.MAX_SAFE_INTEGER;
    const rightOrder = right.data.sidebar.order ?? Number.MAX_SAFE_INTEGER;
    return leftOrder - rightOrder || left.id.localeCompare(right.id);
  });

for (const page of tutorialPages) {
  if (page.data.sidebar.order === undefined) {
    throw new Error(`Tutorial page "${page.id}" is missing sidebar.order.`);
  }
}

const units: Array<{ title: string; lessons: (typeof tutorialPages)[number][] }> = [];
for (const page of tutorialPages) {
  if (page.data.unitTitle) {
    units.push({ title: page.data.unitTitle, lessons: [page] });
    continue;
  }

  const unit = units.at(-1);
  if (!unit) {
    throw new Error(`Tutorial page "${page.id}" appears before the first unitTitle.`);
  }
  unit.lessons.push(page);
}

const currentPath = normalizePath(Astro.url.pathname);
const currentUnitIndex = units.findIndex((unit) =>
  unit.lessons.some((lesson) => normalizePath(hrefFor(lesson.id)) === currentPath),
);
if (currentUnitIndex === -1) {
  throw new Error(`Tutorial route "${currentPath}" is not part of a tutorial unit.`);
}

const headings =
  Astro.locals.starlightRoute.toc?.items.filter((heading) => heading.slug !== '_top') ?? [];
const tabId = (index: number) => `${id}-unit-tab-${index}`;
const panelId = (index: number) => `${id}-unit-panel-${index}`;
const tabLabelId = (index: number) => `${id}-unit-label-${index}`;
const tabProgressId = (index: number) => `${id}-unit-progress-${index}`;
---

<tutorial-unit-tabs data-initial-index={currentUnitIndex}>
  <nav class="tutorial-tracker" aria-label="Tutorial tracker">
    <p class="tracker-title">Tutorial tracker</p>
    <div class="unit-tabs" role="tablist" aria-label="Tutorial units">
      {
        units.map((unit, index) => (
          <button
            id={tabId(index)}
            type="button"
            role="tab"
            aria-controls={panelId(index)}
            aria-labelledby={tabLabelId(index)}
            aria-describedby={tabProgressId(index)}
            aria-selected={index === currentUnitIndex ? 'true' : 'false'}
            tabindex={index === currentUnitIndex ? 0 : -1}
          >
            <span id={tabLabelId(index)} class="sr-only">Unit {index}: {unit.title}</span>
            <TutorialUnitProgress
              unitNumber={index}
              paths={unit.lessons.map((lesson) => hrefFor(lesson.id))}
              descriptionId={tabProgressId(index)}
            />
          </button>
        ))
      }
    </div>
    {
      units.map((unit, unitIndex) => (
        <section
          id={panelId(unitIndex)}
          class="unit-panel"
          role="tabpanel"
          aria-labelledby={tabId(unitIndex)}
          hidden={unitIndex !== currentUnitIndex}
        >
          <h2>{unit.title}</h2>
          <ol class="lesson-list">
            {unit.lessons.map((lesson, lessonIndex) => {
              const href = hrefFor(lesson.id);
              const isCurrent = normalizePath(href) === currentPath;
              return (
                <li>
                  <a href={href} aria-current={isCurrent ? 'page' : undefined}>
                    <TutorialProgress path={href} index={lessonIndex} />
                    <span>{lesson.data.title}</span>
                  </a>
                  {isCurrent && headings.length > 0 && (
                    <ul class="page-sections">
                      {headings.map((heading) => (
                        <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </nav>
</tutorial-unit-tabs>

<style>
  tutorial-unit-tabs,
  .tutorial-tracker {
    display: block;
    width: 100%;
  }

  .tutorial-tracker {
    font-size: var(--sl-text-xs);
  }

  .tracker-title {
    margin: 0 0 0.55rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-h5);
    font-weight: 600;
  }

  .unit-tabs {
    display: flex;
    gap: 0.2rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .unit-tabs button {
    display: grid;
    width: 2.75rem;
    min-height: 2.75rem;
    place-items: center;
    margin: 0;
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: 0.35rem 0.35rem 0 0;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  .unit-tabs button:hover {
    color: var(--sl-color-white);
  }

  .unit-tabs button[aria-selected='true'] {
    position: relative;
    z-index: 1;
    margin-bottom: -1px;
    border-color: var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .unit-tabs button:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }

  .unit-panel {
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-top: 0;
    border-radius: 0 0 0.4rem 0.4rem;
    background: var(--sl-color-gray-6);
  }

  .unit-panel[hidden] {
    display: none;
  }

  .unit-panel h2 {
    margin: 0 0 0.75rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }

  .lesson-list,
  .page-sections {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lesson-list {
    display: grid;
    gap: 0.45rem;
  }

  .lesson-list > li > a {
    display: flex;
    gap: 0.45rem;
    align-items: flex-start;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .lesson-list > li > a[aria-current='page'] {
    color: var(--sl-color-white);
    font-weight: 700;
  }

  .lesson-list > li > a[data-status='complete'] {
    color: var(--sl-color-green-high);
  }

  .page-sections {
    display: grid;
    gap: 0.3rem;
    margin: 0.4rem 0 0.35rem 2rem;
  }

  .page-sections a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .page-sections a:hover,
  .lesson-list a:hover {
    color: var(--sl-color-white);
  }

  :global([data-theme='light']) .tracker-title,
  :global([data-theme='light']) .unit-tabs button[aria-selected='true'],
  :global([data-theme='light']) .unit-panel h2,
  :global([data-theme='light']) .lesson-list > li > a[aria-current='page'],
  :global([data-theme='light']) .lesson-list a:hover,
  :global([data-theme='light']) .page-sections a:hover {
    color: var(--sl-color-gray-1);
  }
</style>

<script>
  class TutorialUnitTabs extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => this.select(index), {
          signal: this.controller?.signal,
        });
        tab.addEventListener(
          'keydown',
          (event) => {
            const destination =
              event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? tabs.length - 1
                  : event.key === 'ArrowRight'
                    ? (index + 1) % tabs.length
                    : event.key === 'ArrowLeft'
                      ? (index - 1 + tabs.length) % tabs.length
                      : undefined;
            if (destination === undefined) return;
            event.preventDefault();
            this.select(destination, true);
          },
          { signal: this.controller.signal },
        );
      });
    }

    disconnectedCallback() {
      this.controller?.abort();
    }

    private select(index: number, focus = false) {
      const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(this.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
      });
    }
  }

  if (!customElements.get('tutorial-unit-tabs')) {
    customElements.define('tutorial-unit-tabs', TutorialUnitTabs);
  }
</script>
