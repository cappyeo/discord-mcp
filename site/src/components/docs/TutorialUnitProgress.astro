---
export interface Props {
  unitNumber: number;
  paths: string[];
  descriptionId: string;
}

const { unitNumber, paths, descriptionId } = Astro.props;
const segmentLength = 100 / paths.length;
const gap = paths.length === 1 ? 0 : Math.min(5, segmentLength * 0.25);
const visibleLength = segmentLength - gap;
---

<tutorial-unit-progress data-paths={JSON.stringify(paths)}>
  <span id={descriptionId} class="sr-only">
    <span class="done-count">0</span> of {paths.length} lessons complete
  </span>
  <svg viewBox="0 0 36 36" width="34" height="34" aria-hidden="true">
    {
      paths.map((_, index) => (
        <circle
          class="segment"
          cx="18"
          cy="18"
          r="14"
          pathLength="100"
          stroke-dasharray={`${visibleLength} ${100 - visibleLength}`}
          stroke-dashoffset={-index * segmentLength}
        />
      ))
    }
    <text x="18" y="18">{unitNumber}</text>
  </svg>
</tutorial-unit-progress>

<style>
  tutorial-unit-progress {
    display: grid;
    place-items: center;
  }

  svg {
    overflow: visible;
    transform: rotate(-90deg);
  }

  .segment {
    fill: none;
    stroke: var(--sl-color-gray-5);
    stroke-linecap: round;
    stroke-width: 3.5;
    transition: stroke 150ms ease;
  }

  .segment.done {
    stroke: var(--sl-color-green);
  }

  text {
    fill: currentcolor;
    font-size: 0.75rem;
    font-weight: 500;
    dominant-baseline: middle;
    text-anchor: middle;
    transform: rotate(90deg);
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(button[aria-selected='true']) text {
    font-weight: 700;
  }
</style>

<script>
  import { TutorialProgressStore } from './TutorialProgressStore';

  class TutorialUnitProgress extends HTMLElement {
    private unsubscribers: Array<() => void> = [];

    connectedCallback() {
      const paths = JSON.parse(this.dataset.paths ?? '[]') as string[];
      this.unsubscribers = paths.map((path) =>
        TutorialProgressStore.subscribePageDone(path, () => this.update(paths)),
      );
    }

    disconnectedCallback() {
      for (const unsubscribe of this.unsubscribers) unsubscribe();
    }

    private update(paths: string[]) {
      const done = paths.filter((path) => TutorialProgressStore.getPageDone(path)).length;
      const count = this.querySelector<HTMLElement>('.done-count');
      if (count) count.textContent = String(done);

      this.querySelectorAll<SVGCircleElement>('.segment').forEach((segment, index) => {
        segment.classList.toggle('done', TutorialProgressStore.getPageDone(paths[index] ?? ''));
      });
    }
  }

  if (!customElements.get('tutorial-unit-progress')) {
    customElements.define('tutorial-unit-progress', TutorialUnitProgress);
  }
</script>
