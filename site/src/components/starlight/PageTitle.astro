---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import { getToolDetailContext } from './toolNavigation';

const { entry, id } = Astro.locals.starlightRoute;
const tool = getToolDetailContext(id);
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

{
  tool && (
    <nav class="tool-breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={`${basePath}tools/`}>Tools</a></li>
        <li><a href={`${basePath}tools/${tool.category}/`}>{tool.categoryLabel}</a></li>
        <li aria-current="page"><code>{entry.data.title}</code></li>
      </ol>
    </nav>
  )
}

<DefaultPageTitle />

<style>
  .tool-breadcrumbs {
    margin-block: 0.5rem -0.25rem;
    font-size: var(--sl-text-xs);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    min-width: 0;
    color: var(--sl-color-gray-3);
  }

  li:not(:last-child)::after {
    color: var(--sl-color-gray-4);
    content: '/';
  }

  a {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  a:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 0.2rem;
  }

  code {
    max-width: 100%;
    overflow-wrap: anywhere;
  }
</style>
