---
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';
import logo from '../assets/discord-mcp-logo-dark.png';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="discord-hero">
  <div class="grid" aria-hidden="true"></div>
  <div class="glow glow-primary" aria-hidden="true"></div>
  <div class="glow glow-secondary" aria-hidden="true"></div>
  <div class="content">
    <div class="hero-copy sl-flex">
      <p class="eyebrow">Discord tools for MCP clients</p>
      <div class="copy sl-flex">
        <h1 id="_top" data-page-title set:html={title} />
        {tagline && <div class="tagline" set:html={tagline} />}
      </div>
      {
        actions.length > 0 && (
          <div class="actions sl-flex">
            {actions.map(
              ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
                <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                  {text}
                  {icon?.html && <Fragment set:html={icon.html} />}
                </LinkButton>
              )
            )}
          </div>
        )
      }
    </div>
    <div class="product-preview" aria-label="MCP client to Discord request flow">
      <div class="preview-topline">
        <Image src={logo} alt="" width={46} height={46} />
        <div>
          <strong>Local stdio server</strong>
          <span>No hosted relay</span>
        </div>
        <span class="status">ready</span>
      </div>
      <div class="flow" aria-hidden="true">
        <span>AI client</span><b>→</b><span>discord-mcp</span><b>→</b><span>Discord API</span>
      </div>
      <pre><code><span class="muted">tool</span>  messages_send
<span class="muted">input</span> &#123; channel_id, content &#125;
<span class="muted">out</span>   &#123; message_id, jump_url &#125;</code></pre>
      <div class="preview-footer">
        <span>typed schemas</span><span>least privilege</span><span>structured output</span>
      </div>
    </div>
  </div>
</div>

<style>
  @layer starlight.core {
    .discord-hero {
      isolation: isolate;
      position: relative;
      overflow: hidden;
      margin: 0 calc(-1 * var(--sl-content-pad-x));
      border-block: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
      background:
        radial-gradient(circle at 16% 0%, color-mix(in srgb, var(--sl-color-accent) 32%, transparent), transparent 38rem),
        radial-gradient(circle at 88% 92%, color-mix(in srgb, var(--sl-color-accent) 22%, transparent), transparent 34rem),
        var(--sl-color-bg-nav);
    }

    .content {
      position: relative;
      z-index: 1;
      max-width: 72rem;
      margin-inline: auto;
      padding: clamp(3.25rem, 7vw, 5.5rem) var(--sl-content-pad-x);
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(19rem, 0.95fr);
      gap: clamp(2rem, 6vw, 5rem);
      align-items: center;
    }

    .hero-copy {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      text-align: left;
    }

    .grid {
      position: absolute;
      inset: 0;
      opacity: 0.32;
      background-image:
        linear-gradient(to right, color-mix(in srgb, var(--sl-color-gray-5) 60%, transparent) 1px, transparent 1px),
        linear-gradient(to bottom, color-mix(in srgb, var(--sl-color-gray-5) 60%, transparent) 1px, transparent 1px);
      background-size: 2rem 2rem;
      mask-image: linear-gradient(to bottom, black, transparent 85%);
    }

    .glow {
      position: absolute;
      z-index: -1;
      border-radius: 999px;
      filter: blur(2rem);
      opacity: 0.7;
    }

    .glow-primary {
      width: 20rem;
      height: 20rem;
      top: -12rem;
      left: -6rem;
      background: var(--sl-color-accent);
    }

    .glow-secondary {
      width: 16rem;
      height: 16rem;
      right: -7rem;
      bottom: -10rem;
      background: var(--sl-color-accent-high);
    }

    .eyebrow {
      margin: 0;
      color: var(--sl-color-accent-high);
      font-size: var(--sl-text-sm);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .copy {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    h1 {
      max-width: 16ch;
      margin: 0;
      color: var(--sl-color-white);
      font-size: clamp(var(--sl-text-4xl), calc(1rem + 5vw), var(--sl-text-6xl));
      font-weight: 650;
      line-height: var(--sl-line-height-headings);
      text-wrap: balance;
    }

    .tagline {
      max-width: 58ch;
      color: var(--sl-color-gray-2);
      font-size: clamp(var(--sl-text-base), calc(0.25rem + 1.5vw), var(--sl-text-xl));
      line-height: 1.6;
      text-wrap: balance;
    }

    .actions {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0.875rem;
    }

    .product-preview {
      padding: 1rem;
      color-scheme: dark;
      border: 1px solid hsl(232 45% 32%);
      border-radius: 1rem;
      background: hsl(232 28% 12% / 0.96);
      box-shadow: 0 1.5rem 5rem hsl(232 45% 8% / 0.38);
      backdrop-filter: blur(1rem);
      transform: rotate(1deg);
    }

    .preview-topline,
    .preview-footer,
    .flow {
      display: flex;
      align-items: center;
    }

    .preview-topline {
      gap: 0.7rem;
    }

    .preview-topline img {
      width: 2.65rem;
      height: 2.65rem;
      object-fit: contain;
    }

    .preview-topline div {
      display: grid;
      gap: 0.1rem;
    }

    .preview-topline strong {
      color: hsl(220 30% 96%);
      font-size: 0.9rem;
    }

    .preview-topline span,
    .preview-footer {
      color: hsl(220 18% 72%);
      font-size: 0.72rem;
    }

    .preview-topline .status {
      margin-inline-start: auto;
      padding: 0.25rem 0.5rem;
      color: hsl(150 80% 75%);
      border: 1px solid hsl(150 60% 35%);
      border-radius: 999px;
      background: hsl(150 45% 16%);
    }

    .flow {
      justify-content: space-between;
      gap: 0.5rem;
      margin-block: 1rem;
      padding: 0.65rem 0.75rem;
      color: hsl(220 24% 86%);
      border-block: 1px solid hsl(232 22% 26%);
      font-size: 0.74rem;
      font-weight: 650;
    }

    .flow b {
      color: hsl(235 100% 78%);
    }

    pre {
      margin: 0;
      padding: 0.9rem;
      overflow: auto;
      color: hsl(220 30% 90%);
      border-radius: 0.65rem;
      background: hsl(232 24% 9%);
      font-size: 0.76rem;
      line-height: 1.8;
    }

    .muted {
      color: hsl(235 100% 76%);
    }

    .preview-footer {
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.45rem;
      margin-top: 0.8rem;
    }

    @media (max-width: 50rem) {
      .content {
        grid-template-columns: 1fr;
        padding-block: 3rem;
      }

      .hero-copy,
      .copy {
        align-items: center;
        text-align: center;
      }

      .actions {
        justify-content: center;
      }

      .product-preview {
        width: min(100%, 31rem);
        margin-inline: auto;
        transform: none;
      }
    }

    @media (prefers-reduced-transparency: reduce) {
      .grid,
      .glow {
        display: none;
      }
    }
  }
</style>
